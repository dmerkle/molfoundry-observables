{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit graph-component mixture",
  "type": "object",
  "properties": {
    "schema": {"const": "explicit-component-mixture-v1"},
    "description": {"type": "string"},
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "file": {"type": "string", "minLength": 1},
          "multiplicity": {"type": "integer", "minimum": 1}
        },
        "required": ["id", "file", "multiplicity"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "description", "components"],
  "additionalProperties": false
}
